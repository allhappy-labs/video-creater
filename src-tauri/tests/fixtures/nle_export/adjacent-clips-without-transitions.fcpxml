<?xml version="1.0" encoding="UTF-8"?>
<fcpxml version="1.10">
  <resources>
    <format id="r1" frameDuration="1/24s" width="1920" height="1080"/>
    <asset id="media-1" name="input.mp4" start="0/1s" duration="288/24s" hasVideo="1" format="r1" hasAudio="1" audioSources="1" audioChannels="2">
      <media-rep kind="original-media" src="file://media/input.mp4"/>
    </asset>
    <asset id="audio-1" name="voice.wav" start="0/1s" duration="480/24s" hasAudio="1" audioSources="1" audioChannels="2">
      <media-rep kind="original-media" src="file://media/voice.wav"/>
    </asset>
  </resources>
  <library>
    <event name="Video Creater Export">
      <project name="Test Project">
        <sequence format="r1" duration="192/24s">
          <spine>
            <asset-clip name="Clip item-1" ref="media-1" lane="1" offset="0/24s" duration="96/24s" start="48/24s">
              <adjust-volume amount="-1"/>
            </asset-clip>
            <asset-clip name="Clip item-2" ref="media-1" lane="1" offset="96/24s" duration="96/24s" start="144/24s">
              <adjust-volume amount="-3"/>
            </asset-clip>
            <asset-clip name="Clip up-1" ref="media-1" offset="24/24s" duration="48/24s" start="0/24s"/>
            <asset-clip name="Clip a-1" ref="audio-1" lane="-1" offset="0/24s" duration="72/24s" start="24/24s" audioRole="dialogue"/>
            <asset-clip name="Clip a-2" ref="audio-1" lane="-1" offset="72/24s" duration="72/24s" start="192/24s" audioRole="dialogue"/>
          </spine>
        </sequence>
      </project>
    </event>
  </library>
</fcpxml>
