<?xml version="1.0" encoding="UTF-8"?>
<fcpxml version="1.10">
  <resources>
    <format id="r1" frameDuration="1/24s" width="1920" height="1080"/>
    <effect id="vc-title-basic" name="Basic Title" uid=".../Titles.localized/Bumper:Opener.localized/Basic Title.localized/Basic Title.moti"/>
    <asset id="media-1" name="input.mp4" start="0/1s" duration="288/24s" hasVideo="1" format="r1" hasAudio="1" audioSources="1" audioChannels="2">
      <media-rep kind="original-media" src="file://media/input.mp4"/>
    </asset>
  </resources>
  <library>
    <event name="Video Creater Export">
      <project name="Test Project">
        <sequence format="r1" duration="120/24s">
          <spine>
            <asset-clip name="Opening clip" ref="media-1" offset="0/24s" duration="96/24s" start="0/24s"/>
            <title name="Manual callout" ref="vc-title-basic" lane="1" offset="72/24s" duration="48/24s">
              <text>
                <text-style ref="overlay-item-1-style">Look here</text-style>
              </text>
              <text-style-def id="overlay-item-1-style">
                <text-style font="Helvetica" fontFace="Regular" fontSize="48" fontColor="1 1 1 1" alignment="center"/>
              </text-style-def>
            </title>
          </spine>
        </sequence>
      </project>
    </event>
  </library>
</fcpxml>
