# Copy to ~/.config/video-creater/remote-host.env and replace these example paths.
VIDEO_CREATER_HOST_DATA_DIR=/home/USER/.local/state/video-creater
VIDEO_CREATER_PROJECT_ROOTS=/home/USER/.local/state/video-creater/projects
VIDEO_CREATER_HOST_ORIGIN=https://DEVICE.MAGICDNS.NAME
VIDEO_CREATER_HOST_LABEL=Editing workstation
