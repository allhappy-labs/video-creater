diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..598088edb5b9f07e3229fc8f31e75de33d6c69d8
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,20 @@
+'use strict';
+
+// Bound recursive walkers independently of the input's character limit.
+const MAX_DEPTH = 128;
+const depthError = () => Object.assign(new SyntaxError('Brace nesting exceeds the safe depth limit'), { code: 'BRACES_MAX_DEPTH' });
+const validateDepth = ast => {
+  const pending = [[ast, 0]];
+  const seen = new Set();
+  let count = 0;
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth > MAX_DEPTH || seen.has(node) || ++count > 65536) throw depthError();
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
+module.exports = { MAX_DEPTH, depthError, validateDepth };
